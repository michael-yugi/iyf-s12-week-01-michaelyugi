
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


body {
    font-family: 'Roboto', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: #333333;
    background-color: #f4f4f4;
    padding: 20px;
}


h1 {
    font-size: 36px;
    font-weight: 700;
    color: #1a73e8;
    margin-bottom: 20px;
}

h2 {
    font-size: 28px;
    font-weight: 700;
    color: #174ea6;
    margin-top: 20px;
    margin-bottom: 15px;
}

h3 {
    font-size: 24px;
    font-weight: 600;
    color: #333333;
    margin-top: 15px;
    margin-bottom: 12px;
}

h4 {
    font-size: 20px;
    font-weight: 600;
    color: #333333;
    margin-top: 12px;
    margin-bottom: 10px;
}

h5 {
    font-size: 18px;
    font-weight: 500;
    color: #444444;
    margin-top: 10px;
    margin-bottom: 8px;
}

h6 {
    font-size: 16px;
    font-weight: 500;
    color: #555555;
    margin-top: 8px;
    margin-bottom: 6px;
}


p {
    margin-bottom: 15px;
}


a {
    color: #1a73e8;
    text-decoration: none;
}

a: hover {
    color: #174ea6;
    text-decoration: underline;
}


ul,
ol {
    margin-left: 25px;
    margin-bottom: 15px;
}

li {
    margin-bottom: 5px;
}


img {
    max-width: 100%;
    height: auto;
}


button {
    background-color: #1a73e8;
    color: white;
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-size: 16px;
}

button:hover {
    background-color: #174ea6;
}


@media (max-width: 600px) {
    body {
        padding: 10px;
    }

    h1 {
        font-size: 28px;
    }

    h2 {
        font-size: 24px;
    }

    h3 {
        font-size: 20px;
    }
}
